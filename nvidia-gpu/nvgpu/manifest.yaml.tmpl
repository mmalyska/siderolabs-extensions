version: v1alpha1
metadata:
  name: nvgpu
  version: "{{ .VERSION }}"
  author: Michał Małyska
  description: |
    [{{ .TIER }}] This system extension provides the OE4T/linux-nvgpu and OE4T/linux-nv-oot
    nvmap kernel modules built against a specific Talos version, for NVIDIA Jetson Orin NX
    (and compatible) devices. nvmap provides /dev/nvmap required by libcuda.so.1; nvgpu
    provides /dev/nvgpu/igpu0/* for GPU compute access.
  compatibility:
    talos:
      version: ">= v1.12.0"
